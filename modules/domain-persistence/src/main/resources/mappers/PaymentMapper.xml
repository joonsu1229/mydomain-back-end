<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
  "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.domainreg.persistence.mapper.PaymentMapper">

    <resultMap id="PaymentMap" type="com.domainreg.core.entity.Payment">
        <id property="id" column="id"/>
        <result property="orderId" column="order_id"/>
        <result property="pgProvider" column="pg_provider"/>
        <result property="pgPaymentKey" column="pg_payment_key"/>
        <result property="amount" column="amount"/>
        <result property="status" column="status"/>
        <result property="rawPayload" column="raw_payload"/>
        <result property="paidAt" column="paid_at"/>
    </resultMap>

    <select id="findById" resultMap="PaymentMap">
        SELECT * FROM payments WHERE id = #{id}
    </select>

    <select id="findByPaymentKey" resultMap="PaymentMap">
        SELECT * FROM payments WHERE pg_payment_key = #{paymentKey}
    </select>

    <insert id="insert" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO payments (order_id, pg_provider, pg_payment_key, amount, status, raw_payload, paid_at)
        VALUES (#{orderId}, #{pgProvider}, #{pgPaymentKey}, #{amount}, #{status}, #{rawPayload}::jsonb, #{paidAt})
    </insert>

    <select id="existsByPaymentKey" resultType="boolean">
        SELECT EXISTS(SELECT 1 FROM payments WHERE pg_payment_key = #{paymentKey})
    </select>

</mapper>
