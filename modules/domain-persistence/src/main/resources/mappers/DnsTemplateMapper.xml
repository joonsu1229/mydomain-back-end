<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
  "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.domainreg.persistence.mapper.DnsTemplateMapper">

    <resultMap id="DnsTemplateMap" type="com.domainreg.core.entity.DnsTemplate">
        <id property="id" column="id"/>
        <result property="userId" column="user_id"/>
        <result property="name" column="name"/>
        <result property="description" column="description"/>
        <result property="recordsJson" column="records_json"/>
        <result property="createdAt" column="created_at"/>
        <result property="updatedAt" column="updated_at"/>
    </resultMap>

    <select id="findByUserId" resultMap="DnsTemplateMap">
        SELECT * FROM dns_templates WHERE user_id = #{userId}
        ORDER BY name
    </select>

    <select id="findById" resultMap="DnsTemplateMap">
        SELECT * FROM dns_templates WHERE id = #{id}
    </select>

    <insert id="insert" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO dns_templates (user_id, name, description, records_json)
        VALUES (#{userId}, #{name}, #{description}, #{recordsJson})
    </insert>

    <update id="update">
        UPDATE dns_templates SET
            name = #{name},
            description = #{description},
            records_json = #{recordsJson},
            updated_at = NOW()
        WHERE id = #{id}
    </update>

    <delete id="delete">
        DELETE FROM dns_templates WHERE id = #{id}
    </delete>

</mapper>
