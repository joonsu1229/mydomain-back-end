<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
  "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.domainreg.persistence.mapper.AppSettingMapper">

    <resultMap id="AppSettingMap" type="com.domainreg.core.entity.AppSetting">
        <id property="key" column="key"/>
        <result property="value" column="value"/>
        <result property="description" column="description"/>
        <result property="updatedAt" column="updated_at"/>
    </resultMap>

    <select id="findAll" resultMap="AppSettingMap">
        SELECT key, value, description, updated_at FROM app_settings ORDER BY key
    </select>

    <insert id="upsertValue">
        INSERT INTO app_settings (key, value)
        VALUES (#{key}, #{value})
        ON CONFLICT (key)
        DO UPDATE SET value = EXCLUDED.value, updated_at = NOW()
    </insert>

</mapper>
