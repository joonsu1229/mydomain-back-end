<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
  "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.domainreg.persistence.mapper.BlocklistKeywordMapper">

    <resultMap id="BlocklistKeywordMap" type="com.domainreg.core.entity.BlocklistKeyword">
        <id property="id" column="id"/>
        <result property="keyword" column="keyword"/>
        <result property="category" column="category"/>
        <result property="enabled" column="enabled"/>
        <result property="note" column="note"/>
        <result property="createdAt" column="created_at"/>
        <result property="updatedAt" column="updated_at"/>
    </resultMap>

    <select id="findAll" resultMap="BlocklistKeywordMap">
        SELECT * FROM blocklist_keywords
        ORDER BY category ASC, keyword ASC
    </select>

    <select id="findAllEnabled" resultMap="BlocklistKeywordMap">
        SELECT * FROM blocklist_keywords
        WHERE enabled = TRUE
        ORDER BY category ASC, keyword ASC
    </select>

    <select id="findById" resultMap="BlocklistKeywordMap">
        SELECT * FROM blocklist_keywords WHERE id = #{id}
    </select>

    <select id="countByKeyword" resultType="int">
        SELECT COUNT(*) FROM blocklist_keywords WHERE keyword = #{keyword}
    </select>

    <insert id="insert" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO blocklist_keywords (keyword, category, enabled, note)
        VALUES (#{keyword}, #{category}, #{enabled}, #{note})
    </insert>

    <update id="update">
        UPDATE blocklist_keywords
        SET keyword = #{keyword}, category = #{category},
            enabled = #{enabled}, note = #{note}, updated_at = NOW()
        WHERE id = #{id}
    </update>

    <delete id="delete">
        DELETE FROM blocklist_keywords WHERE id = #{id}
    </delete>

</mapper>
